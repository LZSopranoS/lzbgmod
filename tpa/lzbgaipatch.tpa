COPY_EXISTING ~LZBGAI01.BCS~ ~override~
    DECOMPILE_AND_PATCH BEGIN
		//Demonic Race Buff SPL
		REPLACE_TEXTUALLY ~TriggerOverride(LastSeenBy(Myself),Global("LZAIDemonicEff","LOCALS",0))~ ~!CheckSpellState(LastSeenBy(Myself),LZRACEBUFF)~
		REPLACE_TEXTUALLY ~ActionOverride(LastSeenBy(Myself),SetGlobal("LZAIDemonicEff","LOCALS",1))~ ~~
		//Dragon Race Buff SPL
		REPLACE_TEXTUALLY ~TriggerOverride(LastSeenBy(Myself),Global("LZAIDragonEff","LOCALS",0))~ ~!CheckSpellState(LastSeenBy(Myself),LZRACEBUFF)~
		REPLACE_TEXTUALLY ~ActionOverride(LastSeenBy(Myself),SetGlobal("LZAIDragonEff","LOCALS",1))~ ~~
		//Lich Race Buff SPL
		REPLACE_TEXTUALLY ~TriggerOverride(LastSeenBy(Myself),Global("LZAILichEff","LOCALS",0))~ ~!CheckSpellState(LastSeenBy(Myself),LZRACEBUFF)~
		REPLACE_TEXTUALLY ~ActionOverride(LastSeenBy(Myself),SetGlobal("LZAILichEff","LOCALS",1))~ ~~
		//DemiLich Race Buff SPL
		REPLACE_TEXTUALLY ~TriggerOverride(LastSeenBy(Myself),Global("LZAIDemilichEff","LOCALS",0))~ ~!CheckSpellState(LastSeenBy(Myself),LZRACEBUFF)~
		REPLACE_TEXTUALLY ~ActionOverride(LastSeenBy(Myself),SetGlobal("LZAIDemilichEff","LOCALS",1))~ ~~
		//Class not Mage Buff SPL
		REPLACE_TEXTUALLY ~TriggerOverride(LastSeenBy(Myself),Global("LZAINotMageCEff","LOCALS",0))~ ~!CheckSpellState(LastSeenBy(Myself),LZCLASSBUFF) TriggerOverride(LastSeenBy(Myself),Global("LZAINotMageCEff","LOCALS",0))~
	END


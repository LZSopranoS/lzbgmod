//LZRACEBUFF
OUTER_SET slot_setbuff = IDS_OF_SYMBOL(~splstate~ ~LZRACEBUFF~)
ACTION_IF (slot_setbuff < 0) BEGIN
    OUTER_PATCH ~~ BEGIN
        FOR (idx = 100; idx < 256; ++idx) BEGIN
		    LOOKUP_IDS_SYMBOL_OF_INT value ~splstate~ idx
			PATCH_IF (~%value%~ STR_EQ ~%idx%~) BEGIN
				SET slot_setbuff = idx
                SET idx = 256
            END
        END
    END
    ACTION_IF (slot_setbuff >= 0) BEGIN
        APPEND ~splstate.ids~ ~%slot_setbuff% LZRACEBUFF~ UNLESS ~LZRACEBUFF~
        CLEAR_IDS_MAP
    END
END
//DRAGON，武技超凡手套
COPY_EXISTING ~LZAISP09.SPL~ ~override~
    LPF ADD_SPELL_EFFECT
    INT_VAR
        insert_point = 1  // Add Effect 1 (Under Effect 0)
        opcode = 328      // Set spell state
        target = 2        // Preset target
        parameter2 = slot_setbuff
        timing = 1
        //duration = 0
        special = 1       // use spell states from table
    END
BUT_ONLY

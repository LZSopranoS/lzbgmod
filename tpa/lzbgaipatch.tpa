ACTION_IF (slot_setbuff < 0) BEGIN
    OUTER_PATCH ~~ BEGIN
        FOR (idx = 100; idx < 256; ++idx) BEGIN
		    LOOKUP_IDS_SYMBOL_OF_INT value ~splstate~ idx
			PATCH_IF (~%value%~ STR_EQ ~%idx%~) BEGIN
				SET slot_setbuff = idx
                SET idx = 256
            END
        END
    END
    ACTION_IF (slot_setbuff >= 0) BEGIN
        APPEND ~splstate.ids~ ~%slot_setbuff% LZCLASSBUFF~ UNLESS ~LZCLASSBUFF~
        CLEAR_IDS_MAP
    END
END

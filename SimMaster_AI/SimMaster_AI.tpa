LOAD_TRA ~lzbgmod/SimMaster_AI/lang/schinese/install.tra~

COPY ~lzbgmod/SimMaster_AI/copy~ ~override~

COPY ~lzbgmod/SimMaster_AI/copysay/LZIMAGAI.ITM~ ~override~
	SAY NAME1 @500 SAY NAME2 @502
	SAY UNIDENTIFIED_DESC @501
	SAY DESC @503

COPY ~lzbgmod/SimMaster_AI/copysay/LZSIMMAS.CRE~ ~override~
	SAY NAME1 @509 SAY NAME2 @509
	
COMPILE ~lzbgmod/SimMaster_AI/d~

COMPILE ~lzbgmod/SimMaster_AI/baf~

APPEND  ~itemdial.2da~  ~LZIMAGAI 5689 LZIMAGAI~   UNLESS ~LZIMAGAI~

COPY_EXISTING ~itemdial.2da~ ~override~
	PRETTY_PRINT_2DA
BUT_ONLY

// =====================================
// 批量注入 scripts 目录下的所有自定 AI 脚本
// =====================================
ACTION_BASH_FOR ~scripts~ ~^.+\.bs$~ BEGIN

    // NONE.bs刚好6字节，过滤小于等于6字节的空脚本，防止坏档。NONE.bs里插入内容后再选择实际也不起作用
    ACTION_IF (BASH_FOR_SIZE > 6) BEGIN 

        // 1. 原地 COPY
        COPY ~%BASH_FOR_FILESPEC%~ ~%BASH_FOR_FILESPEC%~
            
            // 2. 直接在内存中把当前的二进制 .bs 反编译为可读的 BAF 文本流
            DECOMPILE_AND_PATCH BEGIN
                
                // 3. 在第 0 字节位置（即最顶部）插入BAF文件，此时处于反编译后的文本环境，INSERT_FILE 插入的是纯文本，不会破坏二进制文件头
                INSERT_FILE 0 ~lzbgmod/SimMaster_AI/baf2/LZSIMPC2.BAF~
                
            END // 4. 退出块时，WeiDU 会自动在内存中把修补后的文本重新编译为二进制
        BUT_ONLY // 5. 只有真正被修改过的文件才写入硬盘
    END
END

EXTEND_TOP ~BDDEFAI.BCS~ ~lzbgmod/SimMaster_AI/baf2/LZSIMPC2.BAF~

//EET多一个AGEN.bcs(在override下对应标准攻击)，EET标准攻击不再是AGEN.BS
ACTION_IF FILE_EXISTS_IN_GAME ~AGEN.bcs~ THEN BEGIN
	EXTEND_TOP ~AGEN.bcs~     ~lzbgmod/SimMaster_AI/baf2/LZSIMPC2.BAF~
END

//EET多AGEN.bcs、FIGHTER3.BCS、OHFIGHT1.BCS
ACTION_IF FILE_EXISTS_IN_GAME ~FIGHTER3.BCS~ THEN BEGIN
	EXTEND_TOP ~FIGHTER3.BCS~ ~lzbgmod/SimMaster_AI/baf2/LZSIMPC2.BAF~
END

//EET多AGEN.bcs、FIGHTER3.BCS、OHFIGHT1.BCS
ACTION_IF FILE_EXISTS_IN_GAME ~OHFIGHT1.BCS~ THEN BEGIN
	EXTEND_TOP ~OHFIGHT1.BCS~ ~lzbgmod/SimMaster_AI/baf2/LZSIMPC2.BAF~
END

//以下BS被同名BCS取代，EET和BG2EE都有
EXTEND_TOP ~CLERIC1.BCS~      ~lzbgmod/SimMaster_AI/baf2/LZSIMPC2.BAF~
EXTEND_TOP ~CONTROL.BCS~      ~lzbgmod/SimMaster_AI/baf2/LZSIMPC2.BAF~
EXTEND_TOP ~DEFAULT.BCS~      ~lzbgmod/SimMaster_AI/baf2/LZSIMPC2.BAF~
EXTEND_TOP ~FIGHTER2.BCS~     ~lzbgmod/SimMaster_AI/baf2/LZSIMPC2.BAF~
EXTEND_TOP ~FIGHTER4.BCS~     ~lzbgmod/SimMaster_AI/baf2/LZSIMPC2.BAF~
EXTEND_TOP ~MAGE1.BCS~        ~lzbgmod/SimMaster_AI/baf2/LZSIMPC2.BAF~
EXTEND_TOP ~MAGE2.BCS~        ~lzbgmod/SimMaster_AI/baf2/LZSIMPC2.BAF~
EXTEND_TOP ~MAGE3.BCS~        ~lzbgmod/SimMaster_AI/baf2/LZSIMPC2.BAF~
EXTEND_TOP ~MAGE4.BCS~        ~lzbgmod/SimMaster_AI/baf2/LZSIMPC2.BAF~
EXTEND_TOP ~THIEF3.BCS~       ~lzbgmod/SimMaster_AI/baf2/LZSIMPC2.BAF~
EXTEND_TOP ~THIEF4.BCS~       ~lzbgmod/SimMaster_AI/baf2/LZSIMPC2.BAF~

// 第一步：扫描 scripts 文件夹，建立已存在的 .bs 脚本索引名单
ACTION_BASH_FOR ~scripts~ ~^.+\.bs$~ BEGIN
    
    // 提取不带后缀的纯文件名（如 AGEN）
    OUTER_SPRINT bs_name ~%BASH_FOR_RES%~
    
    // 转换为大写建立全局关联数组索引，确保比对时不区分大小写
    OUTER_SPRINT bs_name_upper ~%bs_name%~
    ACTION_TO_UPPER bs_name_upper
    
    // 标记该脚本在 scripts 文件夹中存在
    OUTER_SET $scrp_exists(~%bs_name_upper%~) = 1
    
    // 打印调试信息确认扫描到了哪些 bs 文件
    //PRINT ~[扫描 scripts] 发现有效 BS 脚本并登记索引: %bs_name%~
END

// 第二步：读取 PARTYAI.2da，和 scripts 文件夹的内容进行去重对比
COPY_EXISTING ~PARTYAI.2da~ ~override~
    COUNT_2DA_ROWS 2 p_rows
    FOR (row = 1; row < p_rows; ++row) BEGIN
        READ_2DA_ENTRY row 1 2 script_name
	
        // 打印每次循环最原始读取到的内容和对应的行号
        //PATCH_PRINT ~[读取 PARTYAI] 第 %row% 行 - 脚本名: %script_name%~
    
        // 转换为大写进行比对
        SPRINT ~script_name_upper~ ~%script_name%~
        TO_UPPER ~script_name_upper~
    
        // 检查该脚本是否属于 scripts 文件夹中已存在的脚本
        PATCH_IF (VARIABLE_IS_SET $scrp_exists(~%script_name_upper%~)) BEGIN
        END ELSE BEGIN
      
            // 去重：检查该脚本在此次循环中是否已经执行过插入（防止 PARTYAI 内部同名重复）
            PATCH_IF (VARIABLE_IS_SET $scrp_processed(~%script_name_upper%~)) BEGIN
                // 已经处理过同名脚本，打印提示并跳过
                //PATCH_PRINT ~  --> [自身去重] 脚本 %script_name% 已在前面行处理过，跳过插入~
            END ELSE BEGIN
        
                // 确认为未处理过的独有脚本，立即将其标记为“已处理”
                SET $scrp_processed(~%script_name_upper%~) = 1
        
                // 执行置顶注入
                INNER_ACTION BEGIN
					ACTION_IF (FILE_EXISTS_IN_GAME ~%script_name%.bcs~) BEGIN
						EXTEND_TOP ~%script_name%.bcs~ ~lzbgmod/SimMaster_AI/baf2/LZSIMPC2.BAF~
					END ELSE BEGIN
						//PRINT ~    [跳过] 游戏资源中未找到实体文件 %script_name%.bcs~
					END
				END // INNER_ACTION 结束
            END // 内部去重判断结束
        END // 外部排除判断结束
    END
BUT_ONLY

COPY ~lzbgmod/LZSHOP/lua/M_LZSIM.lua~   ~override~

ACTION_IF NOT FILE_EXISTS_IN_GAME ~M_LZPATH.lua~ THEN BEGIN
	COPY ~lzbgmod/LZSHOP/lua/M_LZPATH.lua~   ~override~
END

COPY ~lzbgmod/SimMaster_AI/spl/simulacr.spl~ ~override~

COPY ~lzbgmod/SimMaster_AI/spl/projimag.spl~ ~override~

//检测还原NewSpells.tpa对mislead.spl的修改
ACTION_IF (MOD_IS_INSTALLED ~MESpells.tp2~ ~1000~) OR (MOD_IS_INSTALLED ~MESpells.tp2~ ~1001~) BEGIN
	COPY ~lzbgmod/SimMaster_AI/spl/mislead.spl~ ~override~
END

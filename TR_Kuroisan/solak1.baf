    !GlobalTimerNotExpired("MO_SpellCastTimer","LOCALS")
    CheckStatGT(Myself,0,AURACLEANSING)
  GlobalGT("MO_AcidScroll","LOCALS",0)
  DifficultyGT(NORMAL)
  //EEex Offset Casting Mirror Cloak FourthNearestEnemyOf
  !CheckSpellState(FourthNearestEnemyOf(Myself),SI_EVOCATION)
  //EEex Offset Casting FourthNearestEnemyOf
  !CheckStatGT(FourthNearestEnemyOf(Myself),0,SANCTUARY)
  !CheckStatGT(FourthNearestEnemyOf(Myself),50,RESISTMAGIC)
  CheckStatLT(FourthNearestEnemyOf(Myself),20,RESISTACID)
  TriggerOverride(FourthNearestEnemyOf(Myself),Range(SecondNearestAllyOf(Myself),15))
  See(FourthNearestEnemyOf(Myself))
  False()
THEN
  RESPONSE #100
    NoAction()
END


  !GlobalTimerNotExpired("MO_TimeStopTimer","GLOBAL")
  HaveSpell(WIZARD_BREACH)  // SPWI513.SPL (Breach)
  OR(4)
    CheckSpellState(SecondNearestEnemyOf(Myself),PROTECTION_FROM_MAGICAL_WEAPONS)
    CheckSpellState(SecondNearestEnemyOf(Myself),ABSOLUTE_IMMUNITY)
    CheckSpellState(SecondNearestEnemyOf(Myself),IMPROVED_MANTLE)
    CheckSpellState(SecondNearestEnemyOf(Myself),MANTLE)
  !CheckSpellState(SecondNearestEnemyOf(Myself),SPELL_SHIELD)
  !CheckSpellState(SecondNearestEnemyOf(Myself),SCROLL_OF_PROTECTION_FROM_MAGIC)
  CheckStatLT(SecondNearestEnemyOf(Myself),1,SANCTUARY)
  // Tactics Breach 2
  !StateCheck(SecondNearestEnemyOf(Myself),STATE_NOT_TARGETABLE)
  See(SecondNearestEnemyOf(Myself))
  False()
THEN
  RESPONSE #100
    NoAction()
END


IF
  !Detect([PC])
  OR(2)
    Global("Prep","LOCALS",1)
    HitBy([GOODCUTOFF],CRUSHING)
  Allegiance(Myself,ENEMY)
  !GlobalTimerNotExpired("MO_TeleportToPlayerTimer","LOCALS")
  CheckStatLT(Player1,1,SANCTUARY)
  !StateCheck(Player1,STATE_REALLY_DEAD)
  DifficultyGT(HARD)
THEN
  RESPONSE #100
    SetGlobalTimer("MO_TeleportToPlayerTimer","LOCALS",6)
    ReallyForceSpell(Player1,WIZARD_DIMENSION_DOOR)  // SPWI402.SPL (Dimension Door)
  RESPONSE #100
    Continue()
END


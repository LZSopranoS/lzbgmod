IF
	OR(6)
		CheckStatLT(Myself,13,STR)
		CheckStatLT(Myself,12,DEX)
		CheckStatLT(Myself,13,CON)
		CheckStatLT(Myself,12,INT)
		CheckStatLT(Myself,6,WIS)
		CheckStatLT(Myself,6,CHR)
THEN
	RESPONSE #100
		CreateVisualEffectObject("SPPORTAL",Myself)
		DisplayString(Myself,34746)  // 傲慢的家伙，我诅咒你的灵魂！我不会就这么放过你的！
		SetGlobal("KuroiAlready","GLOBAL",1)
		SetGlobal("KuroiSpawn","GLOBAL",0)
		DestroySelf()
END

IF
	See(NearestEnemyOf(Myself))
	HitBy([GOODCUTOFF],CRUSHING)
	Global("Contingency","LOCALS",0)
THEN
	RESPONSE #100
		DisplayString(Myself,40252)  // 意外术－防护魔法武器
		ApplySpell(Myself,WIZARD_PROTECTION_FROM_MAGIC_WEAPONS)  // SPWI611.SPL (防护魔法武器)
		SetGlobal("Contingency","LOCALS",1)
END

/////////////////////////////////////////////////////////////////////
// Run from Aerial Denial Spells/Zones
/////////////////////////////////////////////////////////////////////
IF
  !CheckSpellState(Myself,AREA_DENIAL)
  Global("MO_AreaDenial","LOCALS",1)
THEN
  RESPONSE #100
    SetGlobal("MO_AreaDenial","LOCALS",0)
    SetGlobal("MO_AreaDenialOnPC","LOCALS",0)
    MoveToOffset([0.0])
    Continue()
END

IF
  !GlobalTimerNotExpired("MO_AreaDenialTimer","LOCALS")
  !Detect([PC])
  CheckSpellState(Myself,AREA_DENIAL)
  Global("MO_AreaDenial","LOCALS",0)
  CheckStatLT(Player1,1,SANCTUARY)
  !StateCheck(Player1,STATE_INVISIBLE)
THEN
  RESPONSE #100
    SetGlobal("MO_AreaDenial","LOCALS",1)
    SetGlobalTimer("MO_AreaDenialTimer","LOCALS",6)
    MoveToObject(Player1)
END


IF
  See(NearestEnemyOfType([PC]))
  Global("Talked","LOCALS",0)
THEN
  RESPONSE #100
    SetGlobal("Talked","LOCALS",1)
    SetGlobalTimer("TooLong","LOCALS",600)
    SelectWeaponAbility(SLOT_WEAPON1,0)
    SelectWeaponAbility(SLOT_WEAPON0,0)
    StartDialogNoSet(NearestEnemyOfType([PC]))
END

IF 
  Global("KuroisanLeave","LOCALS",0)
THEN
  RESPONSE #100
    SetGlobal("KuroisanLeave","LOCALS",1)
    SetGlobalTimer("KuroisanLeaveTimer","LOCALS",EIGHT_HOURS)
END

IF 
  GlobalTimerExpired("KuroisanLeaveTimer","LOCALS")
THEN 
  RESPONSE #100
    SetGlobal("KuroisanLeave","LOCALS",0)
    SetGlobal("KuroiSpawn","GLOBAL",0)
    DestroySelf()
END 

IF
  GlobalTimerExpired("TooLong","LOCALS")
  Global("Talked","LOCALS",1)
THEN
  RESPONSE #100
    CreateVisualEffectObject("SPPORTAL",Myself)
    DisplayString(Myself,34746)  // ~Damn thy soul, upstart! I've not finished with you!~
    SetGlobal("KuroiAlready","GLOBAL",1)
    SetGlobal("KuroiSpawn","GLOBAL",0)
    DestroySelf()
END

IF
  Global("Prep","LOCALS",0)
  See(NearestEnemyOf(Myself))
  DifficultyGT(HARD)
THEN
  RESPONSE #100
    DisplayString(Myself,56010)  // ~I intend to destroy you.~
    SetGlobal("Prep","LOCALS",1)
    SetGlobalTimer("MO_ProtectionTimer","LOCALS",20)
    ReallyForceSpell(Myself,WIZARD_IMPROVED_HASTE)
    ReallyForceSpell(Myself,WIZARD_MIRROR_IMAGE)
    ReallyForceSpell(Myself,WIZARD_SPELL_SHIELD)    
    ReallyForceSpell(Myself,WIZARD_IMPROVED_MANTLE)
    ReallyForceSpell(Myself,WIZARD_BLUR)
    ReallyForceSpell(Myself,WIZARD_RESIST_FEAR)
    ReallyForceSpell(Myself,WIZARD_FIRE_SHIELD_BLUE)
    ReallyForceSpell(Myself,WIZARD_PROTECTION_FROM_MAGIC_ENERGY)
    // IWD Prebuff
    ReallyForceSpell(Myself,WIZARD_SPELL_IMMUNITY_ABJURATION)
    SetGlobal("MO_AcidScroll","LOCALS",3)
    CreateCreature("mosol01",[-1.-1],10)
    CreateCreature("mosol02",[-1.-1],10)
    CreateCreature("mosol03",[-1.-1],10)
END

IF
  Global("Prep","LOCALS",0)
  See(NearestEnemyOf(Myself))
  Difficulty(HARD)

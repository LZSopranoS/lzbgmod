  !Detect([PC])
  CheckSpellState(Myself,AREA_DENIAL)
  Global("MO_AreaDenial","LOCALS",0)
  CheckStatLT(Player6,1,SANCTUARY)
  !StateCheck(Player6,STATE_INVISIBLE)

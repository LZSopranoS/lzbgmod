/////////////////////////////////////////////////////////////////////
// Defensive
/////////////////////////////////////////////////////////////////////
//Change2 by LZ
IF
	OR(2)
		!GlobalTimerNotExpired("MO_SpellCastTimer","LOCALS")
		CheckStatGT(Myself,0,AURACLEANSING)
	See(NearestEnemyOf(Myself))
	HPPercentLT(Myself,81)
	HasItemEquiped("SCRL7O",Myself)  // 防护魔法武器
	!CheckSpellState(Myself,PROTECTION_FROM_MAGICAL_WEAPONS)
	!CheckSpellState(Myself,ABSOLUTE_IMMUNITY)
	!CheckSpellState(Myself,MANTLE)
	!CheckSpellState(Myself,IMPROVED_MANTLE)
	GlobalGT("sopfmwcount","LOCALS",2)
	GlobalLT("sopfmwcount","LOCALS",8)
THEN
	RESPONSE #20
		IncrementGlobal("sopfmwcount","LOCALS",1)
		SetGlobalTimer("MO_SpellCastTimer","LOCALS",ONE_ROUND)
		SetInterrupt(FALSE)
		UseItem("SCRL7O",Myself)  // 防护魔法武器
		ReallyForceSpell(Myself,CLERIC_HEAL)  // SPPR607.SPL (痊愈术)
		ForceSpellRES("SPCL901",Myself)  // 强力旋风攻击
		SetInterrupt(TRUE)
	RESPONSE #20
		IncrementGlobal("sopfmwcount","LOCALS",1)
		SetGlobalTimer("MO_SpellCastTimer","LOCALS",ONE_ROUND)
		SetInterrupt(FALSE)
		UseItem("SCRL7O",Myself)  // 防护魔法武器
		ReallyForceSpell(Myself,CLERIC_HEAL)  // SPPR607.SPL (痊愈术)
		ForceSpellRES("SPWI613",Myself)  // 高等加速术
		ForceSpellRES("SPWI615",LastAttackerOf(Myself))  // 连环闪电
		SetInterrupt(TRUE)
	RESPONSE #40
		IncrementGlobal("sopfmwcount","LOCALS",1)
		SetGlobalTimer("MO_SpellCastTimer","LOCALS",ONE_ROUND)
		SetInterrupt(FALSE)
		UseItem("SCRL7O",Myself)  // 防护魔法武器
		ReallyForceSpell(Myself,CLERIC_HEAL)  // SPPR607.SPL (痊愈术)
		ReallyForceSpell(Myself,WIZARD_MIRROR_IMAGE)  // SPWI212.SPL (镜影术)
		ForceSpellRES("SPWI405",Myself)  // 高等隐形术
		ForceSpellRES("SPWI716",Myself)  // 魔邓肯之剑
		SetInterrupt(TRUE)
	RESPONSE #20
		IncrementGlobal("sopfmwcount","LOCALS",1)
		SetGlobalTimer("MO_SpellCastTimer","LOCALS",ONE_ROUND)
		SetInterrupt(FALSE)
		UseItem("SCRL7O",Myself)  // 防护魔法武器
		ReallyForceSpell(Myself,CLERIC_HEAL)  // SPPR607.SPL (痊愈术)
		ForceSpellRES("SPWI924",Myself)  // 召唤深渊界侍者
		SetInterrupt(TRUE)
END

IF
	See(NearestEnemyOf(Myself))
	HPPercentLT(Myself,81)
	HaveSpell(WIZARD_PROTECTION_FROM_MAGIC_WEAPONS)  // SPWI611.SPL (防护魔法武器)
	!CheckSpellState(Myself,PROTECTION_FROM_MAGICAL_WEAPONS)
	!CheckSpellState(Myself,ABSOLUTE_IMMUNITY)
	!CheckSpellState(Myself,MANTLE)
	!CheckSpellState(Myself,IMPROVED_MANTLE)
	GlobalLT("sopfmwcount","LOCALS",3)
THEN
	RESPONSE #25
		IncrementGlobal("sopfmwcount","LOCALS",1)
		SetInterrupt(FALSE)
		Spell(Myself,WIZARD_PROTECTION_FROM_MAGIC_WEAPONS)  // SPWI611.SPL (防护魔法武器)
		ReallyForceSpell(Myself,CLERIC_HEAL)  // SPPR607.SPL (痊愈术)
		ForceSpellRES("SPWI909",Myself)  // 时间停止
		ForceSpellRES("SPWI615",LastAttackerOf(Myself))  // 连环闪电
		SetInterrupt(TRUE)
	RESPONSE #25
		IncrementGlobal("sopfmwcount","LOCALS",1)
		SetInterrupt(FALSE)
		Spell(Myself,WIZARD_PROTECTION_FROM_MAGIC_WEAPONS)  // SPWI611.SPL (防护魔法武器)
		ReallyForceSpell(Myself,CLERIC_HEAL)  // SPPR607.SPL (痊愈术)
		ForceSpellRES("SPWI909",Myself)  // 时间停止
		ForceSpellRES("SPWI915",Myself)  // 毁灭魔剑
		SetInterrupt(TRUE)
	RESPONSE #50
		IncrementGlobal("sopfmwcount","LOCALS",1)
		SetInterrupt(FALSE)
		Spell(Myself,WIZARD_PROTECTION_FROM_MAGIC_WEAPONS)  // SPWI611.SPL (防护魔法武器)
		ReallyForceSpell(Myself,CLERIC_HEAL)  // SPPR607.SPL (痊愈术)
		ForceSpellRES("SPWI909",Myself)  // 时间停止
		ForceSpellRES("SPWI921",Myself)  // 高等迅捷
		ForceSpellRES("SPWI922",LastAttackerOf(Myself))  // 龙息
		ForceSpellRES("SPWI925",LastAttackerOf(Myself))  // 彗星术
		ForceSpellRES("SPWI812",LastAttackerOf(Myself))  // 亚比达奇凋死术
		SetInterrupt(TRUE)
END

IF
	OR(2)
		!GlobalTimerNotExpired("MO_SpellCastTimer","LOCALS")
		CheckStatGT(Myself,0,AURACLEANSING)
	See(NearestEnemyOf(Myself))
	CheckStatLT(Myself,1,STONESKINS)
	HaveSpell(WIZARD_STONE_SKIN)  // SPWI408.SPL (石肤术)
	CheckStatLT(Myself,40,SPELLFAILUREMAGE)
	!StateCheck(Myself,STATE_POISONED)
	!StateCheck(Myself,STATE_SILENCED)
	!CheckSpellState(Myself,WILD_MAGIC_AREA)
	!CheckSpellState(Myself,DEAD_MAGIC_AREA)
THEN
	RESPONSE #100
		SetGlobalTimer("MO_SpellCastTimer","LOCALS",ONE_ROUND)
		SetInterrupt(FALSE)
		Spell(Myself,WIZARD_STONE_SKIN)  // SPWI408.SPL (石肤术)
		SetInterrupt(TRUE)
END


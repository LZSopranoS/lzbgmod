IF
  OR(2)
    !GlobalTimerNotExpired("MO_SpellCastTimer","LOCALS")
    CheckStatGT(Myself,0,AURACLEANSING)
  !GlobalTimerNotExpired("MO_DeathFogTimer","LOCALS")
  GlobalGT("MO_AcidScroll","LOCALS",0)
  Allegiance(Myself,ENEMY)
  See(LastSeenBy(Myself))
  !Allegiance(LastSeenBy(Myself),ENEMY)
  //EEex Offset Casting Mirror Cloak LastSeenBy
  !CheckSpellState(LastSeenBy(Myself),SI_EVOCATION)
  //EEex Offset Casting LastSeenBy
  !CheckStatGT(LastSeenBy(Myself),0,SANCTUARY)
  !CheckStatGT(LastSeenBy(Myself),50,RESISTMAGIC)
  CheckStatLT(LastSeenBy(Myself),80,RESISTACID)
  CheckStatLT(Myself,40,SPELLFAILUREMAGE)
  !CheckStatGT(Myself,0,CLERIC_INSECT_PLAGUE)
  !StateCheck(Myself,STATE_POISONED)
  !StateCheck(Myself,STATE_SILENCED)
  !CheckSpellState(Myself,WILD_MAGIC_AREA)
  !CheckSpellState(Myself,DEAD_MAGIC_AREA)
THEN
  RESPONSE #100
    SetGlobalTimer("MO_SpellCastTimer","LOCALS",6)
    SetGlobalTimer("MO_DeathFogTimer","LOCALS",18)
    IncrementGlobal("MO_AcidScroll","LOCALS",-1)
    DisplayStringHead(Myself,46153)  // ~uses a scroll~
    SetInterrupt(FALSE)
    EEex_SpellObjectOffsetNoDec(LastSeenBy(Myself),WIZARD_DEATH_FOG,[-1.-1])
    SetInterrupt(TRUE)
  RESPONSE #100
    Continue()
END

/////////////////////////////////////////////////////////////////////
// Spell: Shadow Door
/////////////////////////////////////////////////////////////////////
IF
  OR(2)
    !GlobalTimerNotExpired("MO_SpellCastTimer","LOCALS")
    CheckStatGT(Myself,0,AURACLEANSING)
  !GlobalTimerNotExpired("MO_ShadowCast","LOCALS")
  HaveSpell(WIZARD_SHADOW_DOOR)
  See(Myself)
  Allegiance(Myself,ENEMY)
  OR(2)
    See(NearestEnemyOf(Myself))
    HitBy([GOODCUTOFF],CRUSHING)
  CheckStatLT(Myself,40,SPELLFAILUREMAGE)
  !CheckStatGT(Myself,0,CLERIC_INSECT_PLAGUE)
  !StateCheck(Myself,STATE_POISONED)
  !StateCheck(Myself,STATE_SILENCED)
  !CheckSpellState(Myself,WILD_MAGIC_AREA)
  !CheckSpellState(Myself,DEAD_MAGIC_AREA)
THEN
  RESPONSE #100
    SetGlobalTimer("MO_SpellCastTimer","LOCALS",6)
    SetGlobalTimer("MO_ShadowCast","LOCALS",32)
    SetInterrupt(FALSE)
    Spell(Myself,WIZARD_SHADOW_DOOR)
    SetInterrupt(TRUE)
  RESPONSE #100
    Continue()
END

/////////////////////////////////////////////////////////////////////
// Spell: Kai
/////////////////////////////////////////////////////////////////////
IF
  OR(2)
    !GlobalTimerNotExpired("MO_SpellCastTimer","LOCALS")
    CheckStatGT(Myself,0,AURACLEANSING) 
  DifficultyGT(NORMAL)
  HaveSpell(KENSAI_KIA)
  Range(SixthNearestEnemyOf(Myself),6)
  !CheckSpellState(Myself,KENSAI_KIA)
  CheckStatLT(SixthNearestEnemyOf(Myself),1,STONESKINS)
  CheckStatGT(SixthNearestEnemyOf(Myself),-20,ARMORCLASS)
  WeaponEffectiveVs(SixthNearestEnemyOf(Myself),MAINHAND)
  WeaponCanDamage(SixthNearestEnemyOf(Myself),MAINHAND)
  See(SixthNearestEnemyOf(Myself))
THEN
  RESPONSE #100
    NoAction()
END


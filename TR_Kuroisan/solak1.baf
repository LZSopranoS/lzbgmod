/////////////////////////////////////////////////////////////////////
// Heal!
/////////////////////////////////////////////////////////////////////
//Change3 by LZ
IF
	!GlobalTimerNotExpired("MO_SpellCastTimer","LOCALS")
	Allegiance(Myself,ENEMY)
	HasItem("POTN52",Myself)  // 强力医疗药水
	HPPercentLT(Myself,71)
	CheckStatLT(Myself,71,RESISTSLASHING)
	CheckStatLT(Myself,71,RESISTCRUSHING)
	CheckStatLT(Myself,71,RESISTPIERCING)
	Global("sopfmwcount","LOCALS",8)
THEN
	RESPONSE #100
		SetGlobalTimer("MO_SpellCastTimer","LOCALS",ONE_ROUND)
		SetInterrupt(FALSE)
		UseItem("POTN52",Myself)  // 强力医疗药水
		ReallyForceSpell(Myself,WARRIOR_HARDINESS)  // SPCL907.SPL (强韧)
		SetInterrupt(TRUE)
END

/////////////////////////////////////////////////////////////////////
// Spell: Remove Magic
/////////////////////////////////////////////////////////////////////
IF
  OR(2)
    !GlobalTimerNotExpired("MO_SpellCastTimer","LOCALS")
    CheckStatGT(Myself,0,AURACLEANSING)
  !GlobalTimerNotExpired("MO_RemoveMagicTimer","LOCALS")
  !GlobalTimerNotExpired("MO_RemoveMagicGlobalTimer","GLOBAL")
  HaveSpell(WIZARD_DISPEL_MAGIC)
  OR(2)
    CheckSpellState(SixthNearestEnemyOf(Myself),BUFF_PRO_WEAPONS)
    CheckSpellState(SixthNearestEnemyOf(Myself),BUFF_PRO_DAMAGE)
  EEex_LuaTrigger("return MORemoveMagic1(6)")
  !CheckSpellState(SixthNearestEnemyOf(Myself),SI_ABJURATION)
  !CheckSpellState(SixthNearestEnemyOf(Myself),SCROLL_OF_PROTECTION_FROM_MAGIC)
  CheckStat(SixthNearestEnemyOf(Myself),0,MINORGLOBE)
  //EEex Offset Casting SixthNearestEnemyOf
  See(SixthNearestEnemyOf(Myself))
  False()
THEN
  RESPONSE #100
    NoAction()
END

